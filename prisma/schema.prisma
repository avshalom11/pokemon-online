// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id
  name            String
  email           String
  emailVerified   Boolean        @default(false)
  image           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  username        String?
  displayUsername String?
  sessions        Session[]
  accounts        Account[]
  playerProfile   PlayerProfile?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

// Game-domain data, deliberately kept out of the auth tables above (which
// are owned/regenerated by the Better Auth CLI). Related 1:1 to User via
// userId. Created automatically on registration — see
// lib/auth/player-profile.ts and lib/auth/auth.ts's databaseHooks.
//
// `username` is stored lowercase by Better Auth's username plugin
// (confirmed: "Avshalom"/"avshalom"/"AVSHALOM" all normalize to the same
// stored value before either the pre-check or the insert), so the standard
// @@unique([username]) above is a real database-level guarantee against
// duplicate normalized usernames for every code path this app uses — it is
// not merely an application pre-check that a race could slip past. See the
// project's security-limitations notes for the one residual theoretical gap
// (a hypothetical write that bypasses Better Auth's normalization entirely)
// and the standard hardening option (a citext column or a functional
// LOWER(username) unique index) if stronger defense-in-depth is ever wanted.
model PlayerProfile {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String
  level                  Int                     @default(1)
  experience             Int                     @default(0)
  // Rare/premium currency. Renamed from `gems` — that system was never read
  // or written by any gameplay logic (display-only), and the project's
  // earlier separate `gold` column was equally dead, so this replaces both
  // rather than the game having three currency-ish fields. `coins` (below)
  // is the only other currency.
  gold                   Int                     @default(0)
  energy                 Int                     @default(100)
  onboardingCompleted    Boolean                 @default(false)
  starterPokemonId       String?
  coins                  Int                     @default(500)
  pokemon                PlayerPokemon[]
  fieldBattleSession     FieldBattleSession?
  notifications          Notification[]
  dailyFieldBattleCounts DailyFieldBattleCount[]
  inventoryItems         PlayerInventoryItem[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@map("player_profile")
}

// Ownership/progression records only — never static species data (name,
// types, base stats, image paths, description). Every consumer (battle,
// inventory, Pokédex, evolution, ...) resolves speciesId against the single
// species catalog in data/pokemon/pokemon-data.ts, so that catalog stays the
// only place species facts live.
model PlayerPokemon {
  id                   String        @id @default(cuid())
  playerId             String
  player               PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  speciesId            String
  nickname             String?
  level                Int           @default(5)
  experience           Int           @default(0)
  currentHp            Int
  isStarter            Boolean       @default(false)
  // 1-6, null = not in the active party. Range validated in app code
  // (features/party/validation/party.schema.ts) — Prisma's schema DSL has
  // no declarative CHECK constraint support in this setup.
  partySlot            Int?
  // Phase 6F — the single major status condition this Pokémon currently
  // carries outside of battle-local stat stages (which never persist here
  // — see FieldBattleSession's own stage fields). Plain string ("burn" |
  // "poison" | "paralysis" | "sleep" | "freeze" | null), validated at the
  // app layer against MajorStatus (features/battle/status) — same
  // no-Prisma-enum precedent as FieldBattleSession.zoneId. Persists exactly
  // like currentHp already does (it's real Pokémon-state, not ephemeral
  // battle UI state), and is cleared the same way currentHp is restored:
  // by the Pokémon Center heal flow.
  status               String?
  // Sleep's remaining-turn counter (Phase 6G) — only ever meaningful while
  // status === "sleep"; null otherwise. Freeze has no counter (it's a
  // per-turn thaw-chance roll, not a fixed duration).
  statusTurnsRemaining Int?
  // Level-Based Evolution — the smallest clean design for "at most one
  // pending decision, plus a permanent yes/no" (deliberately not a
  // separate table like PlayerPendingMoveLearning: that model's queue
  // needs multiple historical rows per Pokémon, evolution never does — see
  // features/evolution's own architecture notes). Non-null exactly when
  // this Pokémon reached a level-evolution threshold and hasn't yet
  // accepted or rejected it; always the target species id, validated
  // against data/pokemon/pokemon-evolutions.ts before being trusted for
  // anything. Cleared (set back to null) the instant either decision is
  // made — see features/evolution/services/accept-evolution.service.ts
  // and reject-evolution.service.ts.
  pendingEvolutionSpeciesId String?
  // Once true, this specific PlayerPokemon instance can never be offered
  // evolution again — set only by a player's explicit rejection, never
  // automatically, and never cleared by anything (a permanent decision per
  // the phase spec). Scoped to this one owned instance only: another owned
  // Pokémon of the same species, or this same Pokémon's own future
  // evolutionary stages once it *does* evolve, are never affected by
  // another instance's block.
  evolutionPermanentlyBlocked Boolean @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // A PlayerPokemon currently the active battler in a persisted field
  // session (see FieldBattleSession below) — used only to block release
  // (features/pokemon/services/release-pokemon.service.ts) while a battle
  // still references it. Always empty in practice except for at most one
  // row, since a player has at most one FieldBattleSession; kept as an
  // array because that's how Prisma models the non-owning side of a
  // one-to-many relation.
  fieldBattleSessions FieldBattleSession[]

  // The (at most four) moves this specific Pokémon currently knows — see
  // PlayerKnownMove below and engine/known-moves for the domain rules.
  knownMoves PlayerKnownMove[]

  // Unresolved opportunities to learn a move once Known Moves were already
  // full when it was reached by leveling up (Phase 4D) — see
  // PlayerPendingMoveLearning below and engine/move-learning for the
  // domain rules. Not itself a Known Move until a future phase (4E)
  // resolves it.
  pendingMoveLearnings PlayerPendingMoveLearning[]

  @@unique([playerId, partySlot])
  @@index([playerId])
  @@map("player_pokemon")
}

// One move slot for one owned Pokémon (Phase 4C). Deliberately named
// Player* to match every other ownership/progression model in this file
// (PlayerProfile, PlayerPokemon) rather than an "OwnedPokemon*" prefix
// that doesn't otherwise exist in this schema.
//
// Only the reference (moveId) and its slot are stored — never move name,
// type, power, PP, or any other static move fact. Those live exclusively
// in the static move registry (engine/moves) and are resolved by id at
// read time; duplicating them here would let this table drift out of
// sync with that registry. Likewise this table has no PP/currentPp
// column of any kind — there is no PP gameplay in this project yet (see
// engine/known-moves's module doc comment).
//
// slot is 1-4, app-validated by engine/known-moves's knownMoveSetSchema
// (contiguous starting at 1) — same precedent as PlayerPokemon.partySlot
// above: Prisma's schema DSL has no declarative CHECK constraint support
// in this setup, so the *shape* rule (contiguity) lives in application
// code, while the two structural constraints Postgres *can* enforce
// (no two rows for the same Pokémon sharing a moveId, no two rows for the
// same Pokémon sharing a slot) are declared as real unique indexes below.
model PlayerKnownMove {
  id              String        @id @default(cuid())
  playerPokemonId String
  playerPokemon   PlayerPokemon @relation(fields: [playerPokemonId], references: [id], onDelete: Cascade)
  moveId          String
  slot            Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([playerPokemonId, moveId])
  @@unique([playerPokemonId, slot])
  @@index([playerPokemonId])
  @@map("player_known_move")
}

// An unresolved opportunity for one owned Pokémon to learn a move,
// created (Phase 4D) when a level-up made a move eligible but all four
// Known Move slots were already full. Not a Known Move — Phase 4E is what
// lets a player turn a "pending" row into either a learned move (Known
// Move gets created, this row's status becomes "learned") or a
// permanently skipped one ("declined"). Phase 4D only ever creates and
// reads "pending" rows.
//
// moveId is a static registry reference, same precedent as
// PlayerKnownMove.moveId above — never move name/type/power/etc.
// duplicated here.
//
// status is a plain String ("pending" | "learned" | "declined",
// engine/move-learning's PendingMoveLearningStatus), not a Prisma enum —
// same precedent as Notification.type and FieldBattleSession.zoneId
// elsewhere in this file: no Prisma enum kept in sync with a TS union in
// this setup, validated at the app layer instead.
//
// Uniqueness: "no duplicate *unresolved* pending decision for the same
// Pokémon+move" is what actually needs enforcing, but Prisma's schema DSL
// can't declare a partial/filtered unique index (`WHERE status =
// 'pending'`) — only a full-table one. Rather than hand-editing the
// migration SQL to add a partial index Prisma's own schema can't express
// (workable, but exactly the kind of awkwardness this constraint doesn't
// need), @@unique below covers all three fields including status: since
// "pending" is a fixed value, that makes at most one *pending* row
// possible per (Pokémon, move) at the database level — a real, always-on
// constraint, not just an application-level check — while still leaving
// room for a future "learned" or "declined" row for that same pair to
// coexist without ever colliding with it. The primary correctness
// mechanism is still the transactional read-existing-pending-then-decide
// step in features/move-learning (this constraint is the backstop against
// a concurrent/retried write slipping past that check).
model PlayerPendingMoveLearning {
  id              String        @id @default(cuid())
  playerPokemonId String
  playerPokemon   PlayerPokemon @relation(fields: [playerPokemonId], references: [id], onDelete: Cascade)
  moveId          String
  learnedAtLevel  Int
  status          String        @default("pending")
  // Monotonically increasing, independent of moveId/slot — the
  // stable creation-order tiebreak PENDING DECISION ORDER requires
  // (learnedAtLevel ascending, then creation order ascending), since
  // createdAt timestamp precision alone isn't a safe tiebreak for two
  // rows written in the same transaction.
  sequence        Int           @default(autoincrement())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  resolvedAt      DateTime?

  @@unique([playerPokemonId, moveId, status])
  @@index([playerPokemonId, status])
  @@map("player_pending_move_learning")
}

// A player's single in-progress wild encounter, persisted so a page refresh
// (or an accidental navigation away and back) restores the exact same
// battle instead of silently rerolling a new one. `playerId` is @unique —
// deliberately modeling "at most one active session per player" as a
// row-existence fact rather than an `isActive` boolean: this session is
// hard-deleted the moment the battle ends (capture/escape/party defeat), so
// there is never a stale "inactive" row lying around to filter out or drift
// out of sync with reality — existence *is* "active". Continuing in the
// same zone after defeating a wild Pokémon reuses this same row (only the
// wild* fields are overwritten), so the unique id/relation age across an
// entire zone session, not just one encounter.
//
// No soft-delete here or on PlayerPokemon release: nothing in this project
// reads deleted battle sessions or released Pokémon for history/audit
// purposes, so a soft-deleted row would just be permanent dead weight with
// no consumer — see features/pokemon/services/release-pokemon.service.ts's
// own doc comment for the release side of this same reasoning.
model FieldBattleSession {
  id       String        @id @default(cuid())
  playerId String        @unique
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // The requested zone (e.g. "grassland") — validated against ZONE_DATA at
  // the app layer; stored as a plain string since Prisma has no enum synced
  // to that TypeScript union.
  zoneId String

  // Wild Pokémon facts — speciesId resolves against the same static catalog
  // every other Pokémon reference uses (data/pokemon/pokemon-data.ts),
  // never duplicated here as name/types/etc.
  wildSpeciesId String
  wildLevel     Int
  wildCurrentHp Int
  wildMaxHp     Int

  // Whether the player-XP reward for the *current* wild encounter in this
  // row has already been granted — reset to false every time a new wild is
  // set (session creation, and promoteToNextEncounter). Lets the HP-zero
  // moment grant XP exactly once even under duplicate/racing requests,
  // without a separate reward ledger table. See
  // battle-session.service.ts's syncWildHp.
  wildDefeatRewardGranted Boolean @default(false)

  // The already-resolved encounter waiting to be promoted the instant the
  // current wild faints — same fields/meaning as wild*/above, one encounter
  // ahead. Always populated (session creation and every promotion both fill
  // this alongside wild* itself) so there is never a moment where "next" is
  // still being generated: promoteToNextEncounter (battle-session.service.ts)
  // only ever copies these columns into wild* and immediately resolves a
  // fresh replacement for this slot, in the same request/transaction that
  // detected the faint — the server never generates an encounter reactively
  // on the critical path, only ever to refill this one-ahead buffer.
  nextWildSpeciesId String
  nextWildLevel     Int
  nextWildCurrentHp Int
  nextWildMaxHp     Int

  // Every owned Pokémon that has actually entered the *current* wild
  // encounter (become activePlayerPokemonId at least once since the wild
  // was last set), for Pokémon-XP eligibility at victory — see
  // features/pokemon-progression and battle-session.service.ts's
  // recordBattleParticipant/markParticipantFainted/resetBattleParticipants.
  // A plain JSON array of `{ playerPokemonId, fainted, order }` rather than
  // a separate table: it's scoped entirely to one encounter (reset every
  // time a new wild is set, exactly like wildDefeatRewardGranted above),
  // never queried independently of its own session row, and never grows
  // past party size (6) — a related table would add a join for no benefit
  // here. Stored as Prisma.JsonValue at the type level; always parsed
  // through the same runtime shape guard (parseBattleParticipants) rather
  // than trusted directly, so a malformed/legacy row can never crash a
  // read.
  participants Json @default("[]")

  // Phase 6E/6F — battle-local state for the current wild encounter only,
  // reset whenever a new wild is set (session creation and
  // promoteToNextEncounter), exactly like wildDefeatRewardGranted/
  // participants above. Stat stages (-6..+6 per stat) never touch
  // PlayerPokemon/species data — they're pure in-battle UI state, unlike
  // status above which genuinely persists on the Pokémon itself.
  // playerStatStages holds the CURRENTLY ACTIVE player Pokémon's own
  // stages (there's only ever one active battler at a time); reset on
  // switch too (see syncActivePokemon). Shape: Partial<Record<StatName,
  // number>> (engine/moves's StatName), e.g. {"attack": -1, "speed": 2} —
  // always parsed through a runtime guard, never trusted raw, same
  // "invalid -> {}" philosophy parseParticipants already uses.
  wildStatStages   Json @default("{}")
  playerStatStages Json @default("{}")

  // Phase 7 — battle-local Volatile Conditions (confusion, flinch,
  // protect, disable, encore, leech seed, trapping), one JSON blob per
  // side, same reset-per-encounter/reset-per-switch lifecycle as the
  // stages above (see features/battle/volatile/volatile-condition.types.ts
  // for the exact shape — validated through a runtime guard on read,
  // never trusted raw, same "invalid -> {}" philosophy every other JSON
  // column on this model already follows).
  wildVolatileState   Json @default("{}")
  playerVolatileState Json @default("{}")

  // The wild's own major status this encounter — a wild Pokémon is never a
  // PlayerPokemon row, so unlike the player's side (PlayerPokemon.status
  // above) this has nowhere else to live. Same string convention, same
  // reset-per-encounter lifecycle as the stages above (a status inflicted
  // on one wild Pokémon must never carry over to the next one that
  // appears in the same zone session).
  wildStatus               String?
  wildStatusTurnsRemaining Int?

  // The party member currently active in this battle. onDelete: Restrict —
  // the DB itself refuses to delete a PlayerPokemon row while any session
  // still references it, as a defense-in-depth backstop behind the
  // application-level release check (this row is always deleted the
  // moment a battle ends, so in correct operation this can only ever block
  // deleting the Pokémon that's genuinely mid-battle right now).
  activePlayerPokemonId String
  activePlayerPokemon   PlayerPokemon @relation(fields: [activePlayerPokemonId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activePlayerPokemonId])
  @@map("field_battle_session")
}

// A player's wild-Pokémon-victory count for one Asia/Jerusalem calendar
// day — incremented exactly once per wild Pokémon actually defeated (see
// features/daily-battles/services/daily-battle-count.service.ts and its
// one caller, promoteToNextEncounter in battle-session.service.ts). Never
// incremented by starting or restoring a session (a page refresh/reopen),
// escaping, capturing, the player's own party fainting, or nextWild merely
// being pre-generated — only a confirmed wild-victory that promotes the
// encounter counts, and a racing/retried request for that same victory can
// never count it twice (see promoteToNextEncounter's own guard).
//
// `date` is a plain "YYYY-MM-DD" string in Asia/Jerusalem — computed fresh
// from the current time on every read/write, not reset by any scheduled
// job: the day simply rolls over to a new (initially absent) row the
// instant the Jerusalem calendar date changes, so "starts again from 0 at
// midnight" falls out for free. Historical rows are never deleted or
// overwritten — this table is an append-over-time log, one row per
// player per day, kept for future statistics.
model DailyFieldBattleCount {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  date  String
  count Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, date])
  @@map("daily_field_battle_count")
}

// Persistent, player-facing notifications for non-blocking meta/progression
// events (level-ups now; item finds, move learns, evolutions, quests,
// achievements later — see features/notifications/types.ts's
// NotificationType union). Deliberately separate from the battle message
// box (features/battle/utils/battle-messages.ts): battle messages are
// ephemeral, in-memory, battle-only events, while these are durable records
// the player can read on their own time from the global header's bell,
// exactly so meta events never have to block or slow down the battle loop.
model Notification {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Plain string (not a Prisma enum), validated at the app layer against the
  // NotificationType TS union — same precedent as
  // FieldBattleSession.zoneId above ("Prisma has no enum synced to that
  // TypeScript union"), so adding a future notification type is a one-line
  // TS change, never a migration.
  type     String
  message  String
  isRead   Boolean @default(false)
  // Optional structured data for a future richer UI (e.g. which Pokémon
  // evolved) — unused by today's single PLAYER_LEVEL_UP type, kept nullable
  // so it costs nothing until a type actually needs it.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([playerId, isRead])
  @@index([playerId, createdAt])
  @@map("notification")
}

// One row per (player, shop item) the player has ever purchased at least
// one of — quantity-only ownership record for consumable/held items bought
// from the Shop (features/shop). itemId resolves against the static shop
// catalog (features/shop/data/shop-items.ts), same precedent as every other
// *Id field in this file that references a static data catalog instead of
// a DB table (PlayerPokemon.speciesId, PlayerKnownMove.moveId, ...) — so
// adding a new purchasable item is a data-only change, never a migration.
// Deliberately its own model rather than nested JSON on PlayerProfile: other
// systems (e.g. using a Potion mid-battle) will need to read/write one
// item's quantity independently, the same reasoning PlayerPokemon already
// gets its own table instead of living on PlayerProfile.
model PlayerInventoryItem {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  itemId   String
  quantity Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, itemId])
  @@index([playerId])
  @@map("player_inventory_item")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
