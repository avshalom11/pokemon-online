// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                   @id
  name             String
  email            String
  emailVerified    Boolean                  @default(false)
  image            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  username         String?
  displayUsername  String?
  sessions         Session[]
  accounts         Account[]
  playerProfile    PlayerProfile?
  deletionRequests AccountDeletionRequest[]

  // FAILED LOGIN LOCKOUT — LEGACY / UNUSED. These two columns used to be
  // the authoritative GLOBAL per-account lockout state (5 failures from
  // ANYWHERE locked the account out for everyone, everywhere). That design
  // was itself an abuse vector — an attacker only needed to know a victim's
  // username to lock the real owner out from every device — so it was
  // replaced by LoginAttemptLock below, keyed by (identifierKey, ipHash)
  // instead of the account alone: only the offending requester's own
  // IP+identifier pair is ever blocked, never the account globally. Neither
  // field is read or written by lib/auth/login-lockout.ts anymore. Left in
  // place (not dropped) since removal wasn't proven safe within this task —
  // a future migration can drop them once confirmed genuinely dead.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

// AUTH SECURITY — LOGIN RATE LIMITING (username/email + requester IP), the
// replacement for the legacy global User.failedLoginAttempts/lockedUntil
// design (see that model's own doc comment for why: a global lock lets an
// attacker who only knows a victim's identifier lock the real owner out
// from everywhere, just by submitting 5 wrong passwords). Keyed by
// (identifierKey, ipHash) instead: only THAT specific requester is ever
// blocked, and the legitimate owner can always still sign in from a
// different IP/device while an attacker's own source is locked out. See
// lib/auth/login-lockout.ts, the one module that reads/writes this table.
//
// `identifierKey` is a plain normalized string (lowercased email or
// username, via lib/auth/login-lockout.ts's own normalizeLoginIdentifier —
// the SAME normalization sign-in itself uses), deliberately NEVER a
// foreign key to User: an attacker probing entirely made-up usernames must
// still be rate-limited (see this file's own architecture notes on why —
// section "account enumeration protection"), which would be impossible if
// a row could only exist for a real User.
//
// `ipHash` is an HMAC-SHA256 of the resolved client IP, keyed by
// BETTER_AUTH_SECRET (lib/auth/request-ip.ts's hashIp) — never the raw IP.
// The IPv4 address space is small enough that an unsalted/unkeyed hash
// would be practically reversible by brute force, which would defeat the
// entire point of not storing IPs in the clear; keying by a secret this
// app alone holds makes that infeasible.
model LoginAttemptLock {
  id             String    @id @default(cuid())
  identifierKey  String
  ipHash         String
  failedAttempts Int       @default(0)
  // Non-null exactly while this (identifierKey, ipHash) pair is currently
  // locked out. A read against an already-expired lock self-heals it
  // (failedAttempts reset to 0, lockedUntil cleared) rather than leaving it
  // stale — see isLockedOut's own doc comment, same convention the legacy
  // per-account design already established.
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([identifierKey, ipHash])
  @@map("login_attempt_lock")
}

// ACCOUNT DELETION — EMAIL-CONFIRMED PERMANENT DELETE. A small dedicated
// model, same precedent as LoginAttemptLock above, rather than reusing
// Better Auth's own generic Verification table: Better Auth's public API
// (auth.api.*) exposes no documented way for application code to create or
// consume a Verification row for a CUSTOM purpose — the internal-adapter
// methods password-reset relies on (createVerificationValue/
// consumeVerificationValue, see lib/auth/actions.ts's own comment on
// resetPasswordAction) only ever run inside Better Auth's own installed
// endpoints. Reaching into `auth.$context.internalAdapter` from application
// code to fake a second use of that table would be exactly the kind of
// fragile, undocumented reliance this project avoids elsewhere.
//
// `tokenHash` stores only an HMAC-SHA256 of the raw token (see
// lib/auth/account-deletion-token.ts) — the same keyed-hash posture as
// LoginAttemptLock's `ipHash` above (request-ip.ts's hashIp), so a raw DB
// read alone can never be replayed as a valid deletion link. The raw token
// itself is never persisted anywhere; it exists only in the emailed URL.
//
// Single-use via `consumedAt` (null until the deletion actually completes).
// Issuing a new request first invalidates any previous outstanding
// (unconsumed) row for the same user — see account-deletion-request.
// service.ts — so at most one valid deletion link ever exists per account
// at a time. Cascades from User so a row can never outlive the account it
// describes.
model AccountDeletionRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("account_deletion_request")
}

// Game-domain data, deliberately kept out of the auth tables above (which
// are owned/regenerated by the Better Auth CLI). Related 1:1 to User via
// userId. Created automatically on registration — see
// lib/auth/player-profile.ts and lib/auth/auth.ts's databaseHooks.
//
// `username` is stored lowercase by Better Auth's username plugin
// (confirmed: "Avshalom"/"avshalom"/"AVSHALOM" all normalize to the same
// stored value before either the pre-check or the insert), so the standard
// @@unique([username]) above is a real database-level guarantee against
// duplicate normalized usernames for every code path this app uses — it is
// not merely an application pre-check that a race could slip past. See the
// project's security-limitations notes for the one residual theoretical gap
// (a hypothetical write that bypasses Better Auth's normalization entirely)
// and the standard hardening option (a citext column or a functional
// LOWER(username) unique index) if stronger defense-in-depth is ever wanted.
model PlayerProfile {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String
  level               Int     @default(1)
  experience          Int     @default(0)
  // Rare/premium currency. Renamed from `gems` — that system was never read
  // or written by any gameplay logic (display-only), and the project's
  // earlier separate `gold` column was equally dead, so this replaces both
  // rather than the game having three currency-ish fields. `coins` (below)
  // is the only other currency.
  gold                Int     @default(0)
  energy              Int     @default(100)
  onboardingCompleted Boolean @default(false)
  starterPokemonId    String?
  coins               Int     @default(500)

  // Public Profile / Showcase (Phase 1) — features/profile. Every field
  // below is read by the PUBLIC profile view (features/profile/services/
  // public-profile-view.service.ts) subject to its own show*OnProfile
  // toggle; none of it is sensitive (no email, password, currency, or
  // inventory data lives here) — see that service's own doc comment for
  // the exact privacy rules. All validated server-side against a closed
  // set of allowed values before being written (features/profile/
  // validation/profile.schema.ts) — never free-form user input.
  //
  // regionId: plain string, not a Prisma enum — same "no enum synced to a
  // TS union in this setup" precedent as FieldBattleSession.zoneId
  // elsewhere in this file. Every player is "kanto" for now (see
  // shared/types/region.ts); the column exists so the game never has to
  // hardcode the Hebrew region label in UI code, and so more regions can
  // be added later without a schema change.
  regionId                      String  @default("kanto")
  // MAP — SELECTABLE WILD LEVEL RANGE. An index into the fixed, ordered
  // WILD_LEVEL_BRACKETS array (engine/player-level-scaling/
  // wild-level-brackets.config.ts) — the SAME single source of truth field
  // battle encounters already scale wild Pokémon levels from, never a
  // second min/max pair duplicated here (a bracket's own min/max can be
  // rebalanced in that one config file without ever touching this schema).
  // null means "the player has never chosen a bracket yet" — the encounter
  // path then falls back to the highest bracket currently unlocked for
  // their level (features/player/services/wild-level-preference.service.ts),
  // preserving today's existing gameplay behavior for every player who
  // never touches this new control. Never trusted as-is when read: always
  // re-validated against the player's CURRENT level (a stored index can go
  // stale if the config itself is ever rebalanced, or — impossible today,
  // but never assumed — if a player's level somehow decreased) before use.
  selectedWildLevelBracketIndex Int?
  // Short public biography — plain text only, rendered as text content
  // (never dangerouslySetInnerHTML), so it can never carry HTML/links as
  // markup regardless of what characters it contains. Length-capped at the
  // validation layer (150 chars), trimmed before storage. Empty string
  // (never null) means "no bio set" — see showAboutMeOnProfile below for
  // the separate visibility toggle.
  aboutMe                       String  @default("")
  // One of the small curated set of Pokémon front-sprite avatars
  // (features/profile/themes/profile-avatars.ts) — null means "no avatar
  // chosen", which the UI renders as the existing initial-letter fallback.
  // Deliberately a dex number (validated against a fixed allow-list), never
  // a raw image URL, so an arbitrary/external image can never be injected.
  avatarDexNumber               Int?
  // One of the fixed theme ids (features/profile/themes/profile-themes.ts)
  // — a lookup key into a server-defined style map, never free-form CSS/
  // class names from the client.
  profileThemeId                String  @default("default")
  // Privacy toggles for the public profile's optional sections — see
  // public-profile-view.service.ts for exactly what each one gates.
  showPartyOnProfile            Boolean @default(true)
  showStatsOnProfile            Boolean @default(true)
  showAboutMeOnProfile          Boolean @default(true)
  // PROFILE ACHIEVEMENTS (later task) — gates BOTH earned Gym Badges AND
  // Regional Medals as a single setting (never 36 individual switches, and
  // no separate Badge/Medal toggle yet — see this feature's own spec).
  // Same "default true, coalesced with `?? true` on every read for a stale
  // Prisma Client" convention as the three toggles above.
  showGymAchievementsOnProfile  Boolean @default(true)
  // BATTLE RESULT SOUNDS + GLOBAL SOUND TOGGLE (later task) — one global
  // on/off switch for every game sound (battle-theme music, attack SFX,
  // victory/defeat SFX) — a personal preference, not a privacy toggle
  // (never gates what OTHER viewers see, unlike the show*OnProfile fields
  // above). Same "default true, coalesced with `?? true` on every read for
  // a stale Prisma Client" convention. See features/battle/utils/
  // game-audio-settings.ts for the one shared helper every sound-playing
  // primitive reads this through.
  soundEnabled                  Boolean @default(true)

  // ONLINE PRESENCE — the last time this player's client sent a heartbeat
  // while the authenticated game layout was mounted (features/presence).
  // null means "never seen" (treated as offline, same as a heartbeat far in
  // the past) — same "nullable, no @default column" convention
  // avatarDexNumber above already establishes. Never exposed to any client
  // as a raw timestamp: every caller goes through presence.service.ts's
  // isOnline/getOnlinePlayerIdSet/getOnlinePlayerCount, which only ever
  // return a derived boolean or an aggregate count — this feature's own
  // explicit privacy rule.
  lastSeenAt DateTime?

  // The owner's structured public showcase content — an ARRAY of
  // ProfileContentBlock (features/profile/types/profile-content.types.ts),
  // never HTML/CSS/a rich-text document. One JSON field is deliberately
  // enough for Phase 1 (never a separate per-block table): blocks are
  // always read/written as one whole ordered list (order IS the array
  // order), never queried or updated individually, so a normalized table
  // would only add a join for no benefit. Never trusted raw on read —
  // always re-validated through the exact same Zod schema that guards
  // writes (features/profile/validation/profile-content.schema.ts's
  // parseProfileContentBlocks) — same "invalid -> safe empty fallback"
  // philosophy this schema's other JSON columns (e.g.
  // FieldBattleSession.participants) already follow.
  profileContentBlocks Json @default("[]")

  pokemon                      PlayerPokemon[]
  fieldBattleSession           FieldBattleSession?
  notifications                Notification[]
  dailyFieldBattleCounts       DailyFieldBattleCount[]
  inventoryItems               PlayerInventoryItem[]
  seenSpecies                  PlayerSeenSpecies[]
  ownedEggs                    PlayerOwnedEgg[]
  incubators                   PlayerIncubator[]
  // GYMS & LEAGUES PHASE 1 — see each model's own doc comment below.
  gymBattleProgress            PlayerGymBattleProgress[]
  gymBadges                    PlayerGymBadge[]
  regionalChampionProgress     PlayerRegionalChampionProgress[]
  regionalMedals               PlayerRegionalMedal[]
  // GYMS & LEAGUES PHASE 3
  npcBattleSession             NpcBattleSession?
  // GYMS & LEAGUES PHASE 5
  leagueTournamentParticipants LeagueTournamentParticipant[]
  // GLOBAL CHAT — every message this player has ever sent to the one
  // site-wide chat (features/chat). See GlobalChatMessage below.
  globalChatMessages           GlobalChatMessage[]
  // FRIENDS PHASE 1 — see Friendship's own doc comment below for why a
  // single relationship row can be "requester" from one player's side and
  // "addressee" from the other's, and PrivateConversation's for the
  // matching playerA/playerB split.
  friendshipsRequested         Friendship[]                     @relation("FriendshipRequester")
  friendshipsReceived          Friendship[]                     @relation("FriendshipAddressee")
  privateConversationsAsA      PrivateConversation[]            @relation("PrivateConversationPlayerA")
  privateConversationsAsB      PrivateConversation[]            @relation("PrivateConversationPlayerB")
  privateMessagesSent          PrivateMessage[]
  // POKÉMON DAYCARE — PHASE 2 (5 SLOTS). Every Pokémon this player
  // currently has deposited, up to DAYCARE_MAX_SLOTS at once — an array
  // since Phase 1's old @unique-per-player (at most one row) was removed;
  // see PlayerDaycareStay's own doc comment below for how the slot cap is
  // now enforced instead (service-layer, race-safely).
  daycareStays                 PlayerDaycareStay[]
  // GAME TUTORIAL — PHASE 0. At most one row per player — see
  // PlayerTutorialProgress's own doc comment below.
  tutorialProgress             PlayerTutorialProgress?
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt

  // ONLINE PRESENCE — the one index getOnlinePlayerCount's aggregate `{
  // lastSeenAt: { gte: cutoff } }` count query (presence.service.ts) needs
  // to stay cheap regardless of total player count.
  @@index([lastSeenAt])
  @@map("player_profile")
}

// FRIENDS PHASE 1. One row per relationship between two players, at
// whichever stage it's currently in — "pending" (a sent-but-not-yet-
// answered request) or "accepted" (a confirmed friendship). Deliberately
// ONE table serving both roles rather than a separate FriendRequest +
// Friendship pair: an accepted row simply IS the friendship, so there is
// no second record that could ever drift out of sync with it (same
// "row existence/state is the fact" idiom PlayerGymBadge/PlayerSeenSpecies
// already establish elsewhere in this file). A DECLINED request is not
// stored at all — respondToFriendRequest (friendship.service.ts) deletes
// the row outright, which is what lets the same pair send a fresh request
// again later without needing a partial/filtered unique index (Prisma's
// schema DSL can't declare one — same limitation PlayerPendingMoveLearning's
// own doc comment documents elsewhere in this file); only two real
// long-lived states ("pending", "accepted") ever need to be mutually
// exclusive per pair, so a plain full-table unique constraint is enough.
//
// requesterId/addresseeId record WHO SENT the request (needed for the
// notification and for "you cannot accept your own outgoing request"), but
// once status is "accepted" this directional distinction is purely
// historical — the friendship itself is symmetric (see
// friendship.service.ts's getFriendsAndRequests, which reads "the other
// side" from whichever of requester/addressee isn't the caller).
//
// friendPairKey is the canonical, order-independent key
// (buildFriendPairKey: the two player ids sorted, joined by "::") that
// makes "at most one relationship between any two players, ever, no matter
// who sent it" a real database-level guarantee via the unique index below
// — never merely an application-level check a race could slip past. A
// concurrent double-send (both players requesting each other at the same
// instant) collides on this constraint; the loser's insert fails with a
// real P2002, which sendFriendRequest catches and resolves by re-reading
// the row the winner just created (create-then-catch-P2002 — same
// established idiom as e.g. PlayerGymBattleProgress.create elsewhere in
// this file).
model Friendship {
  id          String        @id @default(cuid())
  requesterId String
  requester   PlayerProfile @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   PlayerProfile @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  friendPairKey String

  // "pending" | "accepted" — validated at the app layer, same no-Prisma-enum
  // precedent as every other status-ish column in this schema.
  status String @default("pending")

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([friendPairKey])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendship")
}

// FRIENDS PHASE 1 — PRIVATE CHAT. One row per confirmed-friend pair that
// has ever opened a conversation — exactly one, regardless of who opened
// it first, via the exact same canonical-pair-key uniqueness idiom
// Friendship.friendPairKey above establishes (playerA/playerB are always
// assigned in canonical sorted-id order at creation, so the same two
// players always resolve to the same row). Never created for a
// non-friend pair — private-chat.service.ts's getOrCreateConversation
// re-verifies an accepted Friendship exists for this exact pair before
// ever creating or returning one, so a conversation's mere existence is
// itself proof the two players were confirmed friends at least once.
model PrivateConversation {
  id        String        @id @default(cuid())
  playerAId String
  playerA   PlayerProfile @relation("PrivateConversationPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerBId String
  playerB   PlayerProfile @relation("PrivateConversationPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)

  conversationPairKey String

  createdAt DateTime @default(now())

  messages PrivateMessage[]

  @@unique([conversationPairKey])
  @@map("private_conversation")
}

// FRIENDS PHASE 1 — PRIVATE CHAT. One message in one PrivateConversation.
// Capped at PRIVATE_CHAT_MAX_MESSAGES (features/friends/config/
// friends.config.ts) PER CONVERSATION — sendPrivateMessage
// (private-chat.service.ts) deletes the oldest row(s) beyond that cap,
// scoped to `conversationId`, on every insert — same architecture as
// Global Chat's own GLOBAL_CHAT_MAX_MESSAGES cleanup
// (global-chat.service.ts's sendGlobalChatMessage), just scoped per
// conversation instead of globally, so trimming one conversation can never
// touch another's messages. No `senderName` column, same "resolve the
// display name live through the relation" precedent GlobalChatMessage
// already establishes — never duplicated onto every row.
model PrivateMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   PrivateConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         PlayerProfile       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  message String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("private_message")
}

// Ownership/progression records only — never static species data (name,
// types, base stats, image paths, description). Every consumer (battle,
// inventory, Pokédex, evolution, ...) resolves speciesId against the single
// species catalog in data/pokemon/pokemon-data.ts, so that catalog stays the
// only place species facts live.
model PlayerPokemon {
  id                          String        @id @default(cuid())
  playerId                    String
  player                      PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  speciesId                   String
  nickname                    String?
  level                       Int           @default(5)
  experience                  Int           @default(0)
  currentHp                   Int
  isStarter                   Boolean       @default(false)
  // 1-6, null = not in the active party. Range validated in app code
  // (features/party/validation/party.schema.ts) — Prisma's schema DSL has
  // no declarative CHECK constraint support in this setup.
  partySlot                   Int?
  // Phase 6F — the single major status condition this Pokémon currently
  // carries outside of battle-local stat stages (which never persist here
  // — see FieldBattleSession's own stage fields). Plain string ("burn" |
  // "poison" | "paralysis" | "sleep" | "freeze" | null), validated at the
  // app layer against MajorStatus (features/battle/status) — same
  // no-Prisma-enum precedent as FieldBattleSession.zoneId. Persists exactly
  // like currentHp already does (it's real Pokémon-state, not ephemeral
  // battle UI state), and is cleared the same way currentHp is restored:
  // by the Pokémon Center heal flow.
  status                      String?
  // Sleep's remaining-turn counter (Phase 6G) — only ever meaningful while
  // status === "sleep"; null otherwise. Freeze has no counter (it's a
  // per-turn thaw-chance roll, not a fixed duration).
  statusTurnsRemaining        Int?
  // Level-Based Evolution — the smallest clean design for "at most one
  // pending decision, plus a permanent yes/no" (deliberately not a
  // separate table like PlayerPendingMoveLearning: that model's queue
  // needs multiple historical rows per Pokémon, evolution never does — see
  // features/evolution's own architecture notes). Non-null exactly when
  // this Pokémon reached a level-evolution (or Tyrogue's level-stat, or an
  // already-CHOSEN Branch Evolution target — see pendingEvolutionBranch
  // below) threshold and hasn't yet accepted or rejected it; always the
  // target species id, validated against data/pokemon/pokemon-evolutions.ts
  // before being trusted for anything. Cleared (set back to null) the
  // instant either decision is made — see features/evolution/services/
  // accept-evolution.service.ts and reject-evolution.service.ts. Mutually
  // exclusive with pendingEvolutionBranch: a row is never both a resolved
  // single target AND an unresolved branch choice at once (see
  // evolution-progress.service.ts's tryCreatePendingEvolution).
  pendingEvolutionSpeciesId   String?
  // Evolution Simplification phase — true exactly when this Pokémon
  // reached a Branch Evolution's required level (Eevee's Espeon/Umbreon
  // fork today — data/pokemon/pokemon-evolutions.ts's BRANCH_EVOLUTIONS)
  // and the player hasn't yet chosen which target. Never resolved
  // automatically (no randomness, no time-of-day) — the player's explicit
  // choice (evolution-progress.service.ts's chooseEvolutionBranch) is what
  // moves this back to false and sets pendingEvolutionSpeciesId above to
  // the chosen target, after which the normal accept/reject flow takes
  // over with no branch-specific code needed. Rejecting while this is true
  // (reject-evolution.service.ts) clears it and sets
  // evolutionPermanentlyBlocked below, exactly like rejecting a normal
  // pending evolution.
  pendingEvolutionBranch      Boolean       @default(false)
  // Once true, this specific PlayerPokemon instance can never be offered
  // evolution again — set only by a player's explicit rejection, never
  // automatically, and never cleared by anything (a permanent decision per
  // the phase spec). Scoped to this one owned instance only: another owned
  // Pokémon of the same species, or this same Pokémon's own future
  // evolutionary stages once it *does* evolve, are never affected by
  // another instance's block.
  evolutionPermanentlyBlocked Boolean       @default(false)
  // HOME — SIGNIFICANT CAPTURES TODAY — a plain, nullable acquisition-tag
  // string, same precedent as PlayerOwnedEgg.source above: validated at the
  // app layer against PlayerPokemonAcquisitionSource (features/pokemon/
  // services/create-owned-pokemon.service.ts — "capture" | "starter" |
  // "egg") rather than a Prisma enum. Nullable because rows created before
  // this column existed have no reliable source to backfill — those rows
  // are correctly treated as "not a known capture" by anything reading
  // this field (features/home/services/significant-captures.service.ts),
  // never guessed from createdAt alone.
  source                      String?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  // A PlayerPokemon currently the active battler in a persisted field
  // session (see FieldBattleSession below) — used only to block release
  // (features/pokemon/services/release-pokemon.service.ts) while a battle
  // still references it. Always empty in practice except for at most one
  // row, since a player has at most one FieldBattleSession; kept as an
  // array because that's how Prisma models the non-owning side of a
  // one-to-many relation.
  fieldBattleSessions FieldBattleSession[]

  // The (at most four) moves this specific Pokémon currently knows — see
  // PlayerKnownMove below and engine/known-moves for the domain rules.
  knownMoves PlayerKnownMove[]

  // Unresolved opportunities to learn a move once Known Moves were already
  // full when it was reached by leveling up (Phase 4D) — see
  // PlayerPendingMoveLearning below and engine/move-learning for the
  // domain rules. Not itself a Known Move until a future phase (4E)
  // resolves it.
  pendingMoveLearnings PlayerPendingMoveLearning[]

  // POKÉMON DAYCARE — PHASE 1. Non-null exactly while this Pokémon is
  // currently deposited — see PlayerDaycareStay's own doc comment below.
  daycareStay PlayerDaycareStay?

  @@unique([playerId, partySlot])
  @@index([playerId])
  @@map("player_pokemon")
}

// One move slot for one owned Pokémon (Phase 4C). Deliberately named
// Player* to match every other ownership/progression model in this file
// (PlayerProfile, PlayerPokemon) rather than an "OwnedPokemon*" prefix
// that doesn't otherwise exist in this schema.
//
// Only the reference (moveId) and its slot are stored — never move name,
// type, power, PP, or any other static move fact. Those live exclusively
// in the static move registry (engine/moves) and are resolved by id at
// read time; duplicating them here would let this table drift out of
// sync with that registry. Likewise this table has no PP/currentPp
// column of any kind — there is no PP gameplay in this project yet (see
// engine/known-moves's module doc comment).
//
// slot is 1-4, app-validated by engine/known-moves's knownMoveSetSchema
// (contiguous starting at 1) — same precedent as PlayerPokemon.partySlot
// above: Prisma's schema DSL has no declarative CHECK constraint support
// in this setup, so the *shape* rule (contiguity) lives in application
// code, while the two structural constraints Postgres *can* enforce
// (no two rows for the same Pokémon sharing a moveId, no two rows for the
// same Pokémon sharing a slot) are declared as real unique indexes below.
model PlayerKnownMove {
  id              String        @id @default(cuid())
  playerPokemonId String
  playerPokemon   PlayerPokemon @relation(fields: [playerPokemonId], references: [id], onDelete: Cascade)
  moveId          String
  slot            Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([playerPokemonId, moveId])
  @@unique([playerPokemonId, slot])
  @@index([playerPokemonId])
  @@map("player_known_move")
}

// An unresolved opportunity for one owned Pokémon to learn a move,
// created (Phase 4D) when a level-up made a move eligible but all four
// Known Move slots were already full. Not a Known Move — Phase 4E is what
// lets a player turn a "pending" row into either a learned move (Known
// Move gets created, this row's status becomes "learned") or a
// permanently skipped one ("declined"). Phase 4D only ever creates and
// reads "pending" rows.
//
// moveId is a static registry reference, same precedent as
// PlayerKnownMove.moveId above — never move name/type/power/etc.
// duplicated here.
//
// status is a plain String ("pending" | "learned" | "declined",
// engine/move-learning's PendingMoveLearningStatus), not a Prisma enum —
// same precedent as Notification.type and FieldBattleSession.zoneId
// elsewhere in this file: no Prisma enum kept in sync with a TS union in
// this setup, validated at the app layer instead.
//
// Uniqueness: "no duplicate *unresolved* pending decision for the same
// Pokémon+move" is what actually needs enforcing, but Prisma's schema DSL
// can't declare a partial/filtered unique index (`WHERE status =
// 'pending'`) — only a full-table one. Rather than hand-editing the
// migration SQL to add a partial index Prisma's own schema can't express
// (workable, but exactly the kind of awkwardness this constraint doesn't
// need), @@unique below covers all three fields including status: since
// "pending" is a fixed value, that makes at most one *pending* row
// possible per (Pokémon, move) at the database level — a real, always-on
// constraint, not just an application-level check — while still leaving
// room for a future "learned" or "declined" row for that same pair to
// coexist without ever colliding with it. The primary correctness
// mechanism is still the transactional read-existing-pending-then-decide
// step in features/move-learning (this constraint is the backstop against
// a concurrent/retried write slipping past that check).
model PlayerPendingMoveLearning {
  id              String        @id @default(cuid())
  playerPokemonId String
  playerPokemon   PlayerPokemon @relation(fields: [playerPokemonId], references: [id], onDelete: Cascade)
  moveId          String
  learnedAtLevel  Int
  status          String        @default("pending")
  // Monotonically increasing, independent of moveId/slot — the
  // stable creation-order tiebreak PENDING DECISION ORDER requires
  // (learnedAtLevel ascending, then creation order ascending), since
  // createdAt timestamp precision alone isn't a safe tiebreak for two
  // rows written in the same transaction.
  sequence        Int           @default(autoincrement())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  resolvedAt      DateTime?

  @@unique([playerPokemonId, moveId, status])
  @@index([playerPokemonId, status])
  @@map("player_pending_move_learning")
}

// A player's single in-progress wild encounter, persisted so a page refresh
// (or an accidental navigation away and back) restores the exact same
// battle instead of silently rerolling a new one. `playerId` is @unique —
// deliberately modeling "at most one active session per player" as a
// row-existence fact rather than an `isActive` boolean: this session is
// hard-deleted the moment the battle ends (capture/escape/party defeat), so
// there is never a stale "inactive" row lying around to filter out or drift
// out of sync with reality — existence *is* "active". Continuing in the
// same zone after defeating a wild Pokémon reuses this same row (only the
// wild* fields are overwritten), so the unique id/relation age across an
// entire zone session, not just one encounter.
//
// No soft-delete here or on PlayerPokemon release: nothing in this project
// reads deleted battle sessions or released Pokémon for history/audit
// purposes, so a soft-deleted row would just be permanent dead weight with
// no consumer — see features/pokemon/services/release-pokemon.service.ts's
// own doc comment for the release side of this same reasoning.
model FieldBattleSession {
  id       String        @id @default(cuid())
  playerId String        @unique
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // The requested zone (e.g. "grassland") — validated against ZONE_DATA at
  // the app layer; stored as a plain string since Prisma has no enum synced
  // to that TypeScript union.
  zoneId String

  // Wild Pokémon facts — speciesId resolves against the same static catalog
  // every other Pokémon reference uses (data/pokemon/pokemon-data.ts),
  // never duplicated here as name/types/etc.
  wildSpeciesId String
  wildLevel     Int
  wildCurrentHp Int
  wildMaxHp     Int

  // Whether the player-XP reward for the *current* wild encounter in this
  // row has already been granted — reset to false every time a new wild is
  // set (session creation, and promoteToNextEncounter). Lets the HP-zero
  // moment grant XP exactly once even under duplicate/racing requests,
  // without a separate reward ledger table. See
  // battle-session.service.ts's syncWildHp.
  wildDefeatRewardGranted Boolean @default(false)

  // GAME TUTORIAL — PHASE 3. True exactly for the deterministic, guaranteed-
  // capture Pidgey session created by getOrStartBattle's own
  // forceTutorialEncounter path (features/battle-session/services/
  // battle-session.service.ts) — never set any other way, and never true
  // for a normal RNG wild encounter. The one flag capture.service.ts's
  // attemptCapture checks to decide whether a capture attempt bypasses the
  // real capture RNG (same unconditional-success shape as its own existing
  // Master Ball branch) — normal Field Battle capture odds are completely
  // unaffected for every session where this is false.
  isTutorialEncounter Boolean @default(false)

  // The already-resolved encounter waiting to be promoted the instant the
  // current wild faints — same fields/meaning as wild*/above, one encounter
  // ahead. Always populated (session creation and every promotion both fill
  // this alongside wild* itself) so there is never a moment where "next" is
  // still being generated: promoteToNextEncounter (battle-session.service.ts)
  // only ever copies these columns into wild* and immediately resolves a
  // fresh replacement for this slot, in the same request/transaction that
  // detected the faint — the server never generates an encounter reactively
  // on the critical path, only ever to refill this one-ahead buffer.
  nextWildSpeciesId String
  nextWildLevel     Int
  nextWildCurrentHp Int
  nextWildMaxHp     Int

  // Every owned Pokémon that has actually entered the *current* wild
  // encounter (become activePlayerPokemonId at least once since the wild
  // was last set), for Pokémon-XP eligibility at victory — see
  // features/pokemon-progression and battle-session.service.ts's
  // recordBattleParticipant/markParticipantFainted/resetBattleParticipants.
  // A plain JSON array of `{ playerPokemonId, fainted, order }` rather than
  // a separate table: it's scoped entirely to one encounter (reset every
  // time a new wild is set, exactly like wildDefeatRewardGranted above),
  // never queried independently of its own session row, and never grows
  // past party size (6) — a related table would add a join for no benefit
  // here. Stored as Prisma.JsonValue at the type level; always parsed
  // through the same runtime shape guard (parseBattleParticipants) rather
  // than trusted directly, so a malformed/legacy row can never crash a
  // read.
  participants Json @default("[]")

  // Phase 6E/6F — battle-local state for the current wild encounter only,
  // reset whenever a new wild is set (session creation and
  // promoteToNextEncounter), exactly like wildDefeatRewardGranted/
  // participants above. Stat stages (-6..+6 per stat) never touch
  // PlayerPokemon/species data — they're pure in-battle UI state, unlike
  // status above which genuinely persists on the Pokémon itself.
  // playerStatStages holds the CURRENTLY ACTIVE player Pokémon's own
  // stages (there's only ever one active battler at a time); reset on
  // switch too (see syncActivePokemon). Shape: Partial<Record<StatName,
  // number>> (engine/moves's StatName), e.g. {"attack": -1, "speed": 2} —
  // always parsed through a runtime guard, never trusted raw, same
  // "invalid -> {}" philosophy parseParticipants already uses.
  wildStatStages   Json @default("{}")
  playerStatStages Json @default("{}")

  // Phase 7 — battle-local Volatile Conditions (confusion, flinch,
  // protect, disable, encore, leech seed, trapping), one JSON blob per
  // side, same reset-per-encounter/reset-per-switch lifecycle as the
  // stages above (see features/battle/volatile/volatile-condition.types.ts
  // for the exact shape — validated through a runtime guard on read,
  // never trusted raw, same "invalid -> {}" philosophy every other JSON
  // column on this model already follows).
  wildVolatileState   Json @default("{}")
  playerVolatileState Json @default("{}")

  // The wild's own major status this encounter — a wild Pokémon is never a
  // PlayerPokemon row, so unlike the player's side (PlayerPokemon.status
  // above) this has nowhere else to live. Same string convention, same
  // reset-per-encounter lifecycle as the stages above (a status inflicted
  // on one wild Pokémon must never carry over to the next one that
  // appears in the same zone session).
  wildStatus               String?
  wildStatusTurnsRemaining Int?

  // The party member currently active in this battle. onDelete: Restrict —
  // the DB itself refuses to delete a PlayerPokemon row while any session
  // still references it, as a defense-in-depth backstop behind the
  // application-level release check (this row is always deleted the
  // moment a battle ends, so in correct operation this can only ever block
  // deleting the Pokémon that's genuinely mid-battle right now).
  activePlayerPokemonId String
  activePlayerPokemon   PlayerPokemon @relation(fields: [activePlayerPokemonId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activePlayerPokemonId])
  @@map("field_battle_session")
}

// A player's wild-Pokémon-victory count for one Asia/Jerusalem calendar
// day — incremented exactly once per wild Pokémon actually defeated (see
// features/daily-battles/services/daily-battle-count.service.ts and its
// one caller, promoteToNextEncounter in battle-session.service.ts). Never
// incremented by starting or restoring a session (a page refresh/reopen),
// escaping, capturing, the player's own party fainting, or nextWild merely
// being pre-generated — only a confirmed wild-victory that promotes the
// encounter counts, and a racing/retried request for that same victory can
// never count it twice (see promoteToNextEncounter's own guard).
//
// `date` is a plain "YYYY-MM-DD" string in Asia/Jerusalem — computed fresh
// from the current time on every read/write, not reset by any scheduled
// job: the day simply rolls over to a new (initially absent) row the
// instant the Jerusalem calendar date changes, so "starts again from 0 at
// midnight" falls out for free. Historical rows are never deleted or
// overwritten — this table is an append-over-time log, one row per
// player per day, kept for future statistics.
model DailyFieldBattleCount {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  date  String
  count Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, date])
  @@map("daily_field_battle_count")
}

// Persistent, player-facing notifications for non-blocking meta/progression
// events (level-ups now; item finds, move learns, evolutions, quests,
// achievements later — see features/notifications/types.ts's
// NotificationType union). Deliberately separate from the battle message
// box (features/battle/utils/battle-messages.ts): battle messages are
// ephemeral, in-memory, battle-only events, while these are durable records
// the player can read on their own time from the global header's bell,
// exactly so meta events never have to block or slow down the battle loop.
model Notification {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Plain string (not a Prisma enum), validated at the app layer against the
  // NotificationType TS union — same precedent as
  // FieldBattleSession.zoneId above ("Prisma has no enum synced to that
  // TypeScript union"), so adding a future notification type is a one-line
  // TS change, never a migration.
  type     String
  message  String
  isRead   Boolean @default(false)
  // Optional structured data for a future richer UI (e.g. which Pokémon
  // evolved) — unused by today's single PLAYER_LEVEL_UP type, kept nullable
  // so it costs nothing until a type actually needs it.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([playerId, isRead])
  @@index([playerId, createdAt])
  @@map("notification")
}

// One row per (player, shop item) the player has ever purchased at least
// one of — quantity-only ownership record for consumable/held items bought
// from the Shop (features/shop). itemId resolves against the static shop
// catalog (features/shop/data/shop-items.ts), same precedent as every other
// *Id field in this file that references a static data catalog instead of
// a DB table (PlayerPokemon.speciesId, PlayerKnownMove.moveId, ...) — so
// adding a new purchasable item is a data-only change, never a migration.
// Deliberately its own model rather than nested JSON on PlayerProfile: other
// systems (e.g. using a Potion mid-battle) will need to read/write one
// item's quantity independently, the same reasoning PlayerPokemon already
// gets its own table instead of living on PlayerProfile.
model PlayerInventoryItem {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  itemId   String
  quantity Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, itemId])
  @@index([playerId])
  @@map("player_inventory_item")
}

// The persistent "seen" half of Pokédex progress (features/pokedex) — one
// row per (player, species) the player has ever actually encountered in a
// wild field battle. "Caught" is deliberately never stored here (or
// anywhere of its own): it's always derived live from whether any
// PlayerPokemon row for this player has this speciesId — party or storage,
// same "ownership state lives on PlayerPokemon, never duplicated
// elsewhere" rule every other model in this file already follows (see e.g.
// PlayerInventoryItem's own doc comment for the same reasoning applied to
// items). speciesId resolves against the static Species Registry
// (data/pokemon/pokemon-data.ts), never a duplicated species fact.
//
// Existence of a row *is* "seen" — there is no boolean to flip and no
// second write ever needed for the same (player, species) pair, which is
// exactly what makes "refreshing/reopening the same battle must not create
// a duplicate record" trivial: every write here is an upsert keyed by the
// unique constraint below (create on the first encounter, a harmless no-op
// update on every one after), so calling it again for a species already
// seen is always safe. See features/pokedex/services/mark-species-seen.service.ts,
// the only place this table is ever written, and
// features/battle-session/services/battle-session.service.ts's own two
// call sites (a brand-new session's wild, and a promoted wild) — never the
// pre-generated nextWild*, which the player hasn't actually seen yet.
model PlayerSeenSpecies {
  id        String        @id @default(cuid())
  playerId  String
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  speciesId String

  createdAt DateTime @default(now())

  @@unique([playerId, speciesId])
  @@index([playerId])
  @@map("player_seen_species")
}

// EGGS PHASE 1 — Core Data & Database. One row per Pokémon egg the player
// currently owns, unassigned or actively incubating (see
// PlayerEggIncubation below for the latter). `rarity` is a plain String
// (not a Prisma enum), validated at the app layer against PokemonRarity
// (shared/types/pokemon.ts) — same "no enum synced to a TS union in this
// setup" precedent as Notification.type/FieldBattleSession.zoneId
// elsewhere in this file. This is deliberately the egg's REAL rarity value
// (features/eggs/data/egg-definitions.ts is the one source of truth for
// what that maps to — required battles, display name, image) — effective
// encounter-rarity logic (engine/encounter-rarity) is a completely separate
// concept this table never touches.
//
// `regionId` is a plain String (not RegionId directly — same precedent as
// PlayerProfile.regionId), always the region the egg was acquired IN, set
// once at creation and never a live pointer to "the player's current
// region": a battle-dropped egg is stamped with that battle's own region,
// a shop-bought egg with the player's region at purchase time. Neither
// acquisition path is implemented yet (Phase 2+) — this column only exists
// so a future write has somewhere real to put that value; nothing writes it
// today beyond direct data-layer test/service calls.
//
// `source` is a plain String validated against EggAcquisitionSource
// (features/eggs/types/egg.types.ts — "battle" | "shop"), nullable because
// Phase 1 has no real acquisition path yet to always populate it from.
//
// Multiple eggs of the same (playerId, rarity, regionId) are fully
// supported and expected — this is deliberately NOT a quantity counter
// (unlike PlayerInventoryItem above): each egg is its own row with its own
// identity/region/source, because two eggs of the same rarity can come from
// different regions or sources and must stay independently distinguishable
// (in particular, exactly one specific egg row is what an incubation
// actually points at — see PlayerEggIncubation.ownedEggId below; a
// quantity counter has no single identity a foreign key could reference).
model PlayerOwnedEgg {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  rarity   String
  regionId String
  source   String?

  createdAt DateTime @default(now())

  activeIncubation PlayerEggIncubation?

  @@index([playerId])
  @@index([playerId, rarity])
  @@map("player_owned_egg")
}

// One row per incubator INSTANCE a player owns — deliberately its own
// table, never a PlayerInventoryItem quantity row: even a consumable
// incubator instance needs its own identity for PlayerEggIncubation to
// point at while it's actively holding an egg (same "quantity counter has
// no single identity a foreign key could reference" reasoning as
// PlayerOwnedEgg's own doc comment above) — a stackable quantity row could
// never distinguish "this specific Ultra Incubator, mid-incubation" from
// "the other three Ultra Incubators still sitting empty".
//
// `incubatorTypeId` resolves against the static incubator catalog
// (features/eggs/data/incubator-definitions.ts — "regular" | "advanced" |
// "ultra" | "master"), same *Id-references-a-static-catalog precedent as
// PlayerOwnedEgg.rarity/PlayerInventoryItem.itemId. Speed multiplier,
// display name, shop price, etc. all live in that catalog (price lives one
// layer up, in features/shop/data/shop-items.ts, mirroring the egg
// products' own EGG_PRICES split) — never duplicated onto this row — so a
// future incubator type is a data-only addition, never a migration.
//
// INCUBATOR EXPANSION — every player has ever received at most one
// permanent piece of equipment (the starter Regular Incubator); every
// other incubator instance (bought in the Shop, or later granted by a
// chest/reward system via grantIncubator — incubator.service.ts) is a
// single-use consumable, fully independent of every other instance the
// player owns, including duplicates of the exact same type. That is why
// this model dropped its original Phase-1 `@@unique([playerId,
// incubatorTypeId])` — "at most one incubator per player per type" is no
// longer a true invariant now that a player can own, say, three Regular
// Incubators (the permanent one plus two purchased ones) or four Ultra
// Incubators at once.
//
// `permanentSlot` is the new mechanism that keeps "at most one permanent
// starter incubator per player, ever" a real, always-on database guarantee
// rather than an application-level convention, while placing zero
// restriction on how many consumable instances (of any type, including
// duplicates) the same player can also own: it is `1` on exactly the one
// permanent row a player has, and `null` on every consumable row. Postgres
// (like every SQL unique index) treats NULL as distinct from every other
// NULL, so `@@unique([playerId, permanentSlot])` below only ever collides
// for two rows that are BOTH `permanentSlot: 1` for the same player — two
// consumable rows (`permanentSlot: null`) for that same player never
// collide with each other or with the permanent row, no matter how many of
// them exist. features/eggs/services/incubator.service.ts's
// ensureStarterIncubator upserts keyed by exactly this constraint (create
// on first access, a harmless no-op on every call after — the same
// idempotent "lazy creation / ensure-on-access" shape this column's
// predecessor already established), so an existing player safely keeps
// their existing permanent incubator with no mass-data migration beyond a
// one-time backfill (see this phase's own migration) stamping every
// pre-expansion player_incubator row — every one of which WAS that
// player's sole permanent Standard/Regular Incubator, by Phase 1's own
// prior invariant — with `permanentSlot = 1`.
//
// "Is this instance permanent/reusable, or consumable/single-use" is
// therefore always `permanentSlot !== null` — see incubator.service.ts's
// isIncubatorPermanent — never a second redundant boolean column that could
// drift out of sync with this one, same "derive it, don't duplicate it"
// precedent PlayerEggIncubation's own isIncubationReady already
// establishes for "ready".
model PlayerIncubator {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  incubatorTypeId String
  permanentSlot   Int?

  createdAt DateTime @default(now())

  activeIncubation PlayerEggIncubation?

  @@unique([playerId, permanentSlot])
  @@index([playerId])
  @@map("player_incubator")
}

// One egg's active incubation state — existence of a row *is* "this egg is
// currently incubating in this incubator", the same "existence, not a
// boolean flag" philosophy FieldBattleSession's own doc comment already
// establishes for "is there an active battle". This is deliberately why
// `ownedEggId` is this row's own primary key rather than a separate cuid:
// a second `create` for the same egg is a primary-key collision at the
// database level, so "one egg cannot be incubated twice" is enforced by
// the schema itself, not merely by application code remembering to check
// first. `incubatorId` carries its own @@unique for the mirror guarantee
// ("one incubator can hold only one egg at a time") the exact same way.
// features/eggs/services/incubation.service.ts's startIncubatingEgg still
// checks both before writing (inside a transaction) so the caller gets a
// clean rejection result instead of a raw constraint-violation error, but
// the constraints below are the real backstop against a racing/retried
// call, not merely a nicety.
//
// No direct playerId column — reachable via either egg.playerId or
// incubator.playerId (both always agree, enforced by
// startIncubatingEgg's own ownership check before creating this row), same
// "don't duplicate a fact already reachable through an existing relation"
// precedent PlayerKnownMove already follows (no playerId column there
// either, only playerPokemonId).
//
// `battleProgress` starts at 0 and is always counted in real, whole
// battles: every eligible field-battle victory adds a flat +1 to it
// (features/eggs/services/incubation.service.ts's progressActiveIncubations),
// regardless of which incubator holds the egg. `requiredBattleTarget` is a
// snapshot computed once at start time — Math.ceil(the egg's own rarity's
// requiredBattlesStandard / the incubator's own speedMultiplier at that
// exact moment, features/eggs/data/incubator-definitions.ts) — never a
// live formula re-evaluated on every read, so a future balance pass to an
// incubator type's speedMultiplier never reshuffles an already-in-progress
// incubation's own target. Math.ceil is what keeps this column a whole
// battle count even for a non-integer multiplier (Advanced's x1.5).
//
// INCUBATOR SPEED MODEL — a faster incubator's speed lives entirely in
// this SHORTER target, never in a bigger per-victory increment: an earlier
// revision of this feature instead scaled `battleProgress` itself by the
// incubator's own multiplier (via a fixed PROGRESS_SCALE unit system) —
// deliberately reverted, since a flat "+1 per victory, shorter target"
// model is simpler and matches how this feature was ultimately specified.
// "Ready" is deliberately never a stored column — it's always derived as
// `battleProgress >= requiredBattleTarget`
// (features/eggs/services/incubation.service.ts's isIncubationReady), so
// there is no second flag that could ever drift out of sync with the two
// numbers that actually define it.
model PlayerEggIncubation {
  ownedEggId String         @id
  egg        PlayerOwnedEgg @relation(fields: [ownedEggId], references: [id], onDelete: Cascade)

  incubatorId String          @unique
  incubator   PlayerIncubator @relation(fields: [incubatorId], references: [id], onDelete: Cascade)

  battleProgress       Int @default(0)
  requiredBattleTarget Int

  startedAt DateTime @default(now())

  @@map("player_egg_incubation")
}

// GYMS & LEAGUES PHASE 1 — Data & Progression Foundation. Normalized
// progression, deliberately NOT 27 hardcoded boolean columns on
// PlayerProfile (e.g. kantoGym1Done) — one row per (player, region,
// gymNumber, battleSlot) instead, the same "generic model keyed by player +
// progression target" shape PlayerSeenSpecies already established.
//
// Row existence IS the fact, same idiom as PlayerSeenSpecies: no boolean
// "isDone" column, completedAt is set once at insert and this row is never
// updated or deleted afterward — a battle already won can never be
// replayed, and this table is the one source of truth every unlock/
// completion check (features/gyms/services/gym-progression.service.ts)
// reads. `regionId`/`battleSlot` are plain Strings (not Prisma enums),
// validated at the app layer against RegionId (shared/types/region.ts) and
// GymBattleSlotId (features/gyms/types/gym.types.ts) — same no-enum
// precedent as FieldBattleSession.zoneId elsewhere in this file. Phase 2/3
// (actual battle execution) is the only thing that ever creates a row here;
// this Phase only defines the shape and read/write primitives.
model PlayerGymBattleProgress {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  regionId   String
  gymNumber  Int
  battleSlot String

  completedAt DateTime @default(now())

  @@unique([playerId, regionId, gymNumber, battleSlot])
  @@index([playerId])
  @@map("player_gym_battle_progress")
}

// One row per Gym Badge actually earned — a separate fact from
// PlayerGymBattleProgress's own leader-battle-slot row (which only tracks
// "this specific battle was won," the input to unlock logic) so a future
// Badge Case screen, league-eligibility query, or Phase 4 reward-claim
// guard never has to interpret battle-slot rows to answer "does this
// player hold this badge" — it just checks this table directly. Awarded
// exactly once, atomically alongside the matching leader-battle-slot row,
// by markGymBattleCompleted (gym-progression.service.ts) — never earned,
// revoked, sold, or traded any other way. Same "row existence is the fact"
// idiom as PlayerSeenSpecies/PlayerGymBattleProgress above.
model PlayerGymBadge {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  regionId  String
  gymNumber Int

  awardedAt DateTime @default(now())

  @@unique([playerId, regionId, gymNumber])
  @@index([playerId])
  @@map("player_gym_badge")
}

// One row per Regional Champion battle actually won — same "row existence
// is the fact, permanent, never replayed" idiom as
// PlayerGymBattleProgress above, just region-scoped instead of
// region+gymNumber-scoped (a Regional Champion is one battle per region,
// not per gym).
model PlayerRegionalChampionProgress {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  regionId String

  completedAt DateTime @default(now())

  @@unique([playerId, regionId])
  @@index([playerId])
  @@map("player_regional_champion_progress")
}

// One row per Regional Medal actually earned — same relationship to
// PlayerRegionalChampionProgress as PlayerGymBadge has to
// PlayerGymBattleProgress above (a separate achievement fact, not derived
// ad hoc from the battle-completion row at read time). Awarded exactly
// once, atomically alongside the matching champion-progress row, by
// markRegionalChampionDefeated (gym-progression.service.ts).
model PlayerRegionalMedal {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  regionId String

  awardedAt DateTime @default(now())

  @@unique([playerId, regionId])
  @@index([playerId])
  @@map("player_regional_medal")
}

// GYMS & LEAGUES PHASE 3 — Gym Battle Engine. A separate session model from
// FieldBattleSession on purpose: an NPC battle has a genuinely different
// shape (a fixed multi-Pokémon roster fought sequentially, no reward/
// promotion/one-ahead-buffer concepts at all) — force-fitting it into
// FieldBattleSession's wild-only fields (wildSpeciesId/wildCurrentHp/
// nextWildSpeciesId/wildDefeatRewardGranted/participants) would mix
// wild-only assumptions into a system that must never trigger wild
// rewards/Egg drops/Chest drops/daily-count/incubation progress (see this
// Phase's own Field Battle isolation rule). The actual battle MECHANICS
// (damage/status/turn-order/move-effects) are never duplicated — both this
// session type and FieldBattleSession are driven by the exact same shared
// engine, features/battle/services/battle-turn-engine.ts.
//
// BATTLE-LOCAL HP/STATUS ONLY — this is the key isolation property: unlike
// Field Battle (which writes PlayerPokemon.currentHp/.status directly,
// since a wild encounter's damage is meant to persist), a Gym/Regional
// battle NEVER reads or writes PlayerPokemon.currentHp/.status at all.
// Every participating Pokémon's HP/status/stat-stages/volatile for THIS
// attempt lives entirely in playerBattleHp/playerBattleStatus/
// playerStatStages/playerVolatileState below, keyed by playerPokemonId.
// This is what makes "every Gym/Regional battle is independent" (approved
// design) trivially true: a real Pokémon's permanent HP is never touched,
// so nothing here can ever leak into — or be corrupted by — Field Battle,
// Pokémon Center healing, or a different Gym attempt.
model NpcBattleSession {
  id       String        @id @default(cuid())
  playerId String        @unique
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // "gym" | "regional-champion" — validated at the app layer against
  // NpcBattleSource (features/gyms/types/npc-battle.types.ts), same
  // no-Prisma-enum precedent as FieldBattleSession.zoneId.
  battleSource String
  regionId     String
  // Only set when battleSource === "gym"; null for a Regional Champion
  // battle (no gym number/battle slot).
  gymNumber    Int?
  battleSlot   String?

  // The fixed NPC roster for THIS attempt, frozen at battle start — Phase
  // 2's own fixed species, each given a level resolved ONCE via
  // resolveNpcTeamLevels (Phase 2) and never rerolled turn-to-turn. Array
  // of { speciesId: string; level: number }, in fight order.
  npcTeam                 Json
  npcActiveIndex          Int     @default(0)
  npcCurrentHp            Int
  npcStatus               String?
  npcStatusTurnsRemaining Int?
  npcStatStages           Json    @default("{}")
  npcVolatileState        Json    @default("{}")

  // The player's participating roster for THIS attempt — the first N real
  // PlayerPokemon ids (N = this battle format's own max party size),
  // snapshotted at start in existing party-slot order. Never mutates the
  // real party itself.
  playerPokemonIds      Json
  activePlayerPokemonId String
  // Record<playerPokemonId, currentHp> — see this model's own "BATTLE-LOCAL
  // HP ONLY" doc comment above. Every participant starts at their own full
  // HP (calculated from species+level) the instant this session is created.
  playerBattleHp        Json
  playerBattleStatus    Json   @default("{}")
  playerStatStages      Json   @default("{}")
  playerVolatileState   Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("npc_battle_session")
}

// GYMS & LEAGUES PHASE 5 — one persistent instance of a weekly League
// tournament occurrence. `leagueId` is "league-1" | "league-2" | "league-3"
// (Phase 1's own RegionalLeagueId — validated at the app layer, same
// no-Prisma-enum precedent as NpcBattleSession.battleSource); the Champions
// League never gets an instance of this model in this Phase (section 16 —
// no manual registration, no tournament creation until qualifiers exist).
// `weekKey` is the Asia/Jerusalem calendar date (YYYY-MM-DD, same format as
// getJerusalemDateKey) of that occurrence's own Thursday — the stable
// dedupe key that makes "the same weekly tournament must not be created
// twice" a plain DB-level unique constraint rather than app-level
// read-then-write logic.
model LeagueTournament {
  id       String @id @default(cuid())
  leagueId String
  weekKey  String

  registrationClosesAt DateTime
  round1StartsAt       DateTime

  // "registration-open" | "registration-closed" | "generated" |
  // "in-progress" | "completed" — plain string, validated at the app layer
  // (features/leagues/types/tournament.types.ts), same convention as every
  // other status-ish column in this schema.
  status String @default("registration-open")

  // GYMS & LEAGUES PHASE 8 — the exactly-once reward-grant guard (section
  // 22). Deliberately NOT derived from `status === "completed"`: multiple
  // processes can race around completion itself, so this is its own
  // separate null-then-set-once column, updated via the same guarded-
  // updateMany CAS idiom every other exactly-once primitive in this
  // project already uses (`updateMany({ where: { rewardsGrantedAt: null },
  // data: { rewardsGrantedAt: now } })`) — never read/write raced against
  // `status`.
  rewardsGrantedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants LeagueTournamentParticipant[]
  matches      LeagueTournamentMatch[]
  placements   LeagueTournamentPlacement[]

  @@unique([leagueId, weekKey])
  @@map("league_tournament")
}

// One row per tournament participant — a real registered player OR a
// computer filler generated at Round-1-pairing time for an odd real-player
// count (section 8/9). `playerId` is null exactly for a computer row;
// Postgres treats each NULL as distinct under a composite unique index, so
// @@unique([tournamentId, playerId]) enforces "at most one registration per
// real player per tournament" while placing no limit on how many computer
// rows may ever exist (application logic — not this constraint — is what
// keeps that to exactly one per round, per this Phase's own pairing rule).
// Deliberately stores NO mutable copy of Gym eligibility — eligibility is
// always re-checked live from real Gym progression at registration time
// (league-eligibility.service.ts), never cached here.
model LeagueTournamentParticipant {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   LeagueTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  playerId String?
  player   PlayerProfile? @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // "player" | "computer" — validated at the app layer.
  participantType String

  registeredAt DateTime @default(now())

  matchesAsParticipantA LeagueTournamentMatch[] @relation("LeagueMatchParticipantA")
  matchesAsParticipantB LeagueTournamentMatch[] @relation("LeagueMatchParticipantB")
  matchesWon            LeagueTournamentMatch[] @relation("LeagueMatchWinner")

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@map("league_tournament_participant")
}

// The minimum persistent shape for one Round-N pairing (section 7) — pure
// foundation only: no PvP battle-room/session exists yet, and nothing in
// this Phase ever sets `winnerParticipantId` outside of a test. `slot` is
// this match's 0-based order within its own round (tournamentId,
// roundNumber), so a round's bracket can always be reconstructed in a
// stable, deterministic order.
model LeagueTournamentMatch {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   LeagueTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  roundNumber Int
  slot        Int
  scheduledAt DateTime

  participantAId String
  participantA   LeagueTournamentParticipant @relation("LeagueMatchParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   LeagueTournamentParticipant @relation("LeagueMatchParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)

  winnerParticipantId String?
  winner              LeagueTournamentParticipant? @relation("LeagueMatchWinner", fields: [winnerParticipantId], references: [id])

  // "scheduled" | "in-progress" | "completed" — validated at the app layer.
  status           String  @default("scheduled")
  // Denormalized for a cheap "is either side a computer filler" read
  // without joining participantA/participantB — set once at generation
  // time, never recomputed.
  involvesComputer Boolean @default(false)

  // GYMS & LEAGUES PHASE 7 — how this match's winner was actually decided:
  // "normal-battle" | "opponent-no-show" | "random-no-show" |
  // "timeout-living-pokemon" | "timeout-player-level" | "timeout-first-entry" |
  // "timeout-deterministic-fallback" (features/leagues/utils/league-tiebreak.ts
  // owns the last four). Null only before the match has a winner. Set
  // exactly once, atomically alongside winnerParticipantId — never
  // recomputed afterward (a completed match is immutable).
  resolutionReason String?

  battleSession LeagueBattleSession?

  @@unique([tournamentId, roundNumber, slot])
  @@index([tournamentId, roundNumber])
  @@map("league_tournament_match")
}

// GYMS & LEAGUES PHASE 7 — the authoritative 1st/2nd/3rd place record for a
// completed League tournament (section 22). A separate, minimal model
// rather than nullable columns on LeagueTournament itself — cleaner for a
// variable number of places (a 2-real-player tournament legitimately has
// no 3rd place at all, section 23) and makes future Champions League
// qualification queries trivial ("League I's most recent completed
// tournament's place=1 row"). `participantId` is always a REAL player's
// own LeagueTournamentParticipant id — a computer can never occupy a row
// here (enforced at the app layer: placement derivation only ever
// considers participantType "player" candidates). `playerId` is
// denormalized from that participant purely so a future reward/Champions-
// League query never needs an extra join. Immutable once written — the
// unique constraint below is what makes "write each place exactly once"
// a plain DB guarantee (same create-then-catch-P2002 idiom every other
// exactly-once primitive in this project already uses).
model LeagueTournamentPlacement {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   LeagueTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // 1, 2, or 3.
  place Int

  participantId String
  playerId      String

  createdAt DateTime @default(now())

  @@unique([tournamentId, place])
  @@map("league_tournament_placement")
}

// GYMS & LEAGUES PHASE 6 — the authoritative, battle-local PvP session for
// exactly one LeagueTournamentMatch (1:1 — tournamentMatchId is @unique,
// which is what makes "at most one active League battle session per
// match" a plain DB guarantee, never app-level read-then-write logic; the
// row is created once at first-join and persists through completion —
// leaving the match page never deletes it, per this Phase's own "no
// automatic completion solely from client unmount" rule).
//
// Deliberately a SEPARATE model from both FieldBattleSession and
// NpcBattleSession: PvP has two independently-owned real (or one real +
// one computer) sides, neither of which can supply the other's move the
// way Field Battle's own wild AI or Gym's own NPC AI can — force-fitting
// this into either existing session shape would mean inventing fields
// neither wild encounters nor fixed NPC rosters ever needed. The actual
// battle MATH is never duplicated though — this session's own
// battle-action service resolves every turn through the exact same shared
// engine (features/battle/services/battle-turn-engine.ts) Field Battle and
// Gym Battle already use.
//
// BATTLE-LOCAL STATE ONLY — same isolation property NpcBattleSession
// already established: PlayerPokemon.currentHp/.status is never read or
// written here. Every participating Pokémon's HP/status/stages/volatile
// for THIS match lives entirely in the participantA*/participantB* columns
// below, snapshotted once at that side's own join time and never touching
// the real party.
//
// SIMULTANEOUS-SUBMISSION TURN MODEL — unlike Field/Gym Battle (one HTTP
// request supplies both the player's move AND immediately picks/resolves
// the opponent's), two real humans can't supply each other's move in the
// same request. Each side's own pending move for the CURRENT turnNumber is
// stored independently (participantA/BPendingMoveId); the turn is only
// actually resolved (via resolveBattleTurn, exactly once) the moment BOTH
// sides have a pending move recorded for that same turnNumber — see
// league-battle-action.service.ts's own doc comment for the exact atomic
// guard. For a computer-filler opponent, its "pending move" is selected
// immediately in the same request the real player submits theirs, so play
// always resolves synchronously for that case — no waiting.
model LeagueBattleSession {
  id                String                @id @default(cuid())
  tournamentMatchId String                @unique
  tournamentMatch   LeagueTournamentMatch @relation(fields: [tournamentMatchId], references: [id], onDelete: Cascade)

  // Copied from the match at session-creation time (never re-derived from
  // a client) — plain strings, not enforced FKs, same convention as
  // NpcBattleSession's own regionId/battleSlot columns; every read is
  // still cross-checked against the real LeagueTournamentMatch row by the
  // service layer, never trusted from this session alone.
  participantAId String
  participantBId String

  // Side A — null/empty until participant A actually joins (section 7).
  // Once joined: participantAPokemon is this side's own frozen roster
  // snapshot (up to 6, LeagueBattlePokemonSnapshot[]); participantABattleHp
  // is Record<slotId, currentHp>; participantAStatusMap is
  // Record<slotId, {status, turnsRemaining}> (persists per-Pokémon across a
  // switch); participantAStatStages/participantAVolatileState apply only
  // to whichever slot is currently active (reset on switch, same rule
  // NpcBattleSession already follows).
  participantAJoinedAt      DateTime?
  participantAPokemon       Json?
  participantAActiveSlotId  String?
  participantABattleHp      Json?
  participantAStatusMap     Json      @default("{}")
  participantAStatStages    Json      @default("{}")
  participantAVolatileState Json      @default("{}")
  // This side's own submitted move for the CURRENT turnNumber — cleared
  // back to null the instant a turn actually resolves.
  participantAPendingMoveId String?

  // Side B — exact mirror of Side A above.
  participantBJoinedAt      DateTime?
  participantBPokemon       Json?
  participantBActiveSlotId  String?
  participantBBattleHp      Json?
  participantBStatusMap     Json      @default("{}")
  participantBStatStages    Json      @default("{}")
  participantBVolatileState Json      @default("{}")
  participantBPendingMoveId String?

  // Increments by exactly 1 each time a turn actually resolves — also the
  // optimistic-concurrency guard every turn-resolution write is gated on
  // (an updateMany whose WHERE clause includes the turnNumber it read),
  // so two racing "both sides just submitted" resolutions can never both
  // apply (see league-battle-action.service.ts).
  turnNumber Int @default(1)

  // "waiting-for-players" | "in-progress" | "completed" — validated at the
  // app layer. Becomes "in-progress" the moment both sides have joined;
  // "completed" exactly once, atomically alongside winnerParticipantId and
  // the matching LeagueTournamentMatch's own completion (section 14).
  status              String  @default("waiting-for-players")
  winnerParticipantId String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("league_battle_session")
}

// GLOBAL CHAT — one site-wide chat every authenticated player shares (not
// per-room, not per-player) — rendered as a persistent bottom bar across
// the whole shared game layout (features/chat). `message` is the only
// content column: the sender's display name is never duplicated here —
// it's always resolved live through the `player` relation (same
// "don't store what's reachable through an existing relation" precedent
// PlayerKnownMove's own doc comment establishes elsewhere in this file),
// so a later display-name change is instantly reflected on old messages
// too. Capped at GLOBAL_CHAT_MAX_MESSAGES (features/chat/config/
// global-chat.config.ts) — global-chat.service.ts's sendGlobalChatMessage
// deletes the oldest row(s) beyond that cap on every insert, so this table
// never grows without bound; there is deliberately no scheduled cleanup
// job, since the insert path itself is the only place a new row is ever
// added.
model GlobalChatMessage {
  id       String        @id @default(cuid())
  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  message String

  createdAt DateTime @default(now())

  // Both the "latest N globally" read (getRecentGlobalChatMessages) and the
  // cap-enforcement cleanup (sendGlobalChatMessage) order/filter by
  // createdAt alone, never scoped to one player — a single non-unique index
  // on just this column serves both.
  @@index([createdAt])
  @@map("global_chat_message")
}

// POKÉMON DAYCARE — PHASE 1. One row per Pokémon CURRENTLY deposited in
// the Daycare — deliberately keyed by playerPokemonId itself as the
// primary key (same shared-PK 1:1-relation shape PlayerEggIncubation
// already establishes above for "one active thing per owned item"), so
// "this Pokémon has an active stay" is a plain row-existence check, never
// a second boolean/status column that could drift out of sync with row
// presence — same "row existence IS the fact" idiom Friendship/
// PlayerEggIncubation already establish elsewhere in this file. Pickup
// (features/daycare/services/daycare.service.ts's collectFromDaycare)
// DELETES this row outright once levels are applied, rather than marking
// it "completed" and keeping a history table Phase 1 has no use for — a
// completed stay leaves nothing worth remembering beyond what the
// now-updated PlayerPokemon row itself already reflects (its new level).
//
// PHASE 2 — 5 SLOTS. playerId's own uniqueness (originally what made "at
// most ONE active stay per player" a database-level guarantee for Phase
// 1's single-slot scope) is REMOVED here — a player may now own up to
// DAYCARE_MAX_SLOTS (features/daycare/config/daycare.config.ts) rows at
// once, one per deposited Pokémon. That 5-slot ceiling is enforced by
// depositToDaycare's own service-layer logic (features/daycare/services/
// daycare.service.ts), race-safely: every deposit already has to spend the
// deposit fee against this SAME player's PlayerProfile row, and Postgres's
// own row-level lock on that UPDATE is what serializes two concurrent
// deposit attempts for the same player, making the capacity re-count that
// follows (inside that same transaction) safe against the exact
// TOCTOU race a plain pre-check alone could not prevent — see that
// function's own doc comment for the full reasoning. playerPokemonId
// remains the primary key (never relaxed) — "one Pokémon cannot be in two
// active stays at once" is still a hard, unconditional database guarantee
// regardless of how many slots the surrounding player-level rule allows.
// The plain @@index([playerId]) below is what keeps "all of this player's
// active stays" (getDaycareViewData) and the capacity count itself cheap.
//
// depositedAt + startingLevel remain the ONLY two facts persisted per
// stay — every derived value (earned levels, current effective level,
// debt, time until next level) is deterministically recomputed at read
// time from these two fields plus "now" (features/daycare/
// daycare-calculations.ts's calculateDaycareProgress) — never a
// continually-updated checkpoint counter that could double-count progress
// across repeated reads/page refreshes. Each row's own depositedAt/
// startingLevel is completely independent of every other row for the same
// player, so every deposited Pokémon's progress/debt/countdown is
// independent by construction — there is no shared state between stays to
// accidentally couple them.
model PlayerDaycareStay {
  playerPokemonId String        @id
  // DAYCARE — HIDE DEPOSITED + PROTECT FROM REMOVAL. onDelete: Restrict
  // (not Cascade) — same "block the delete outright rather than silently
  // destroying the row that references it" rule FieldBattleSession.
  // activePlayerPokemon already establishes for a Pokémon that's busy
  // elsewhere. Deleting a PlayerPokemon that's currently deposited must
  // never succeed at all (see release-pokemon.service.ts's own explicit
  // application-level "in-daycare" check, which is what actually produces
  // a clean user-facing rejection before the DB constraint would ever be
  // reached) — Cascade previously let a delete silently destroy the
  // deposit alongside the Pokémon itself.
  pokemon         PlayerPokemon @relation(fields: [playerPokemonId], references: [id], onDelete: Restrict)

  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  depositedAt   DateTime @default(now())
  startingLevel Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
  @@map("player_daycare_stay")
}

// GAME TUTORIAL — PHASE 0. One row per player, tracking progress through the
// central Tutorial stage registry (features/tutorial/data/
// tutorial-stages.config.ts) — same "one flag/row per player, guarded by an
// atomic updateMany, never a per-stage table" idiom PlayerProfile.
// onboardingCompleted already established for a comparable one-time flow.
// Lazily created (getOrCreateTutorialProgress) the first time an
// already-onboarded player loads any (game) route — never part of
// selectStarterPokemon's own transaction, so onboarding stays entirely
// unaware the Tutorial exists.
model PlayerTutorialProgress {
  id       String        @id @default(cuid())
  playerId String        @unique
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // A stable string id into TUTORIAL_STAGES, never a numeric index — the
  // registry can be reordered/extended (e.g. a future Trading stage) later
  // without invalidating already-saved progress.
  currentStageId String  @default("welcome")
  // Sub-step key within the current stage (e.g. the scripted Field Battle
  // stage's own multi-part sequence, added in a later phase) — null
  // whenever the current stage has none. No stage sets this yet in Phase 0.
  currentSubStep String?

  status      String    @default("not_started")
  completedAt DateTime?

  // Not yet read or written by anything in Phase 0 — reserved for the
  // completion-reward phase's exactly-once grant guard, same atomic-
  // updateMany idiom as FieldBattleSession.wildDefeatRewardGranted.
  rewardClaimed Boolean @default(false)

  // GAME TUTORIAL — PHASE 3. True exactly once this player has genuinely
  // captured the guaranteed Tutorial Pidgey (FieldBattleSession.
  // isTutorialEncounter's own guaranteed-capture branch, capture.service.ts)
  // — set exclusively inside that same capture transaction, never by any
  // client-reported event alone. Two jobs: (1) battle-session.service.ts's
  // getOrStartBattle checks this (via getOrCreateTutorialProgress) before
  // ever forcing a fresh tutorial encounter, so the guaranteed capture can
  // only ever be obtained once per account; (2) advanceTutorialSubStep
  // refuses to record the field-battle stage's own "capture-pidgey" step
  // as complete unless this is already true, so a spoofed/racing
  // reportAction call can never advance the Tutorial without a real
  // capture having actually happened.
  pidgeyCaptured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("player_tutorial_progress")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
