# Copy this file to .env and fill in real values locally. Never commit .env.

# PostgreSQL connection string the running app connects with (lib/db/prisma.ts)
# — on Neon, use the POOLED endpoint (PgBouncer, transaction mode) so
# ordinary requests reuse pooled connections, e.g.:
# postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Direct (non-pooled) connection string used only by the Prisma CLI
# (prisma.config.ts) for migrate/introspect/studio — Prisma Migrate's
# advisory locks and DDL are not safe through a PgBouncer transaction-mode
# pooler. On a non-Neon/non-pooled setup this can be the same value as
# DATABASE_URL.
DIRECT_URL=

# Random secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of this app (used by Better Auth to build callback/API URLs).
BETTER_AUTH_URL=http://localhost:3000

# DEV-ONLY manual-testing override — has no effect in production builds
# even if set. When "true" in development, boosts the legendary encounter
# tier to ~20% combined probability (in zones with a thematic legendary
# candidate) so legendary Pokémon can be reached quickly while manually
# testing the rarity UI. See engine/encounter/legendary-test-boost.ts.
LEGENDARY_ENCOUNTER_TEST_MODE=false
