# Template for the DEV environment. Copy this file to `.env.development` and
# fill in the DEV Neon branch's connection strings — see ENVIRONMENTS.md.
#
# NEVER put PLAY (real player-progression) credentials in this file.
# `.env.development` is gitignored, same as `.env` — this template itself
# carries no secrets, only the variable names.

# DEV database — Neon's POOLED endpoint for the DEV branch (used by the app).
DATABASE_URL=

# DEV database — Neon's DIRECT (non-pooled) endpoint for the DEV branch,
# used only by the Prisma CLI (migrate/introspect/studio). Safe to run
# `prisma migrate dev` / `prisma migrate reset` / `prisma db push` here —
# this is the DEV branch, never PLAY.
DIRECT_URL=

# Recommended: a DEV-only secret (different from PLAY's), so a DEV session
# can never be replayed against PLAY. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000

LEGENDARY_ENCOUNTER_TEST_MODE=false

# Optional in DEV — leave blank unless you need to test email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

TRUSTED_PROXY_CIDRS=
